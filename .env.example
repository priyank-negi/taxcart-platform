# Copy to .env for local use. On Render, set these under Environment. Never commit real values.

# Postgres for the portal's own data (logins, clients, settings). Use a new Neon project.
DATABASE_URL=

# The tax engine and its internal key (the engine's INTERNAL_KEY).
TAX_ENGINE_URL=https://tax-engine-ysr4.onrender.com
TAX_ENGINE_KEY=

# Address(es) the portal is served from, comma-separated. Must be https (http only for localhost).
APP_ORIGIN=http://localhost:8100

# First staff login. Used only while the portal has no logins at all; you are asked to
# change the password at first sign-in. Remove both once you have signed in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: days a sign-in lasts (default 7).
# SESSION_DAYS=7
